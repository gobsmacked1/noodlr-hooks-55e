{
  "name": "noodlr-hooks-55e",
  "version": "0.7.46",
  "private": true,
  "type": "module",
  "description": "Noodlr Hooks 5.5e — rules automation for D&D 5e (2024) in Foundry VTT. Standalone; no dependencies.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "check": "tsc --noEmit && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node test/run.mjs",
    "census:notes": "node scripts/census-meta-notes.mjs",
    "census:yield": "node scripts/census-yield.mjs",
    "census:guards": "node scripts/census-guards.mjs",
    "census:subset": "node scripts/subset-cache.mjs",
    "census:rests": "node scripts/peek-rest-rules.mjs",
    "census:trigger": "node scripts/peek-trigger.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "license": "MIT"
}
